# Конфигурация бота
TELEGRAM_BOT_TOKEN=ваш_токен_бота
ADMIN_USER_ID=ваш_user_id

# Настройки обработки
MAX_FILE_SIZE=20  # в MB
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng

# Настройки парсинга
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
REQUEST_DELAY=1.5
SCRAPE_ENABLED=true

# Настройки прокси
PROXY_ENABLED=false
PROXY_LIST=user:pass@proxy1.com:8080,user:pass@proxy2.com:8080

# Настройки логгирования
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7